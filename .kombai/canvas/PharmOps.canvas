   <td class=\"px-6 py-4 font-mono font-bold\" data-kid=\"237\">22</td>\n                <td class=\"px-6 py-4\" data-kid=\"238\"><span class=\"badge badge-warning\" data-kid=\"239\">Proses (62%)</span></td>\n              </tr>\n              <tr data-kid=\"240\">\n                <td class=\"px-6 py-4 font-bold\" data-kid=\"241\">Posyandu Flamboyan</td>\n                <td class=\"px-6 py-4 text-slate-500\" data-kid=\"242\">Sawah Baru</td>\n                <td class=\"px-6 py-4 font-mono font-bold\" data-kid=\"243\">54</td>\n                <td class=\"px-6 py-4 font-mono font-bold\" data-kid=\"244\">0</td>\n                <td class=\"px-6 py-4\" data-kid=\"245\"><span class=\"badge badge-danger\" data-kid=\"246\">Belum Melapor</span></td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  </main>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"247\"></script>\n<script data-kid=\"248\">\n  function toggleAccordion(el) {\n    const isExpanded = el.getAttribute('data-expanded') === 'true';\n    \n    // Close all others\n    document.querySelectorAll('.row-accordion').forEach(row => {\n      row.setAttribute('data-expanded', 'false');\n    });\n\n    if (!isExpanded) {\n      el.setAttribute('data-expanded', 'true');\n    }\n  }\n\n  // Load Animation\n  window.addEventListener('load', () => {\n    gsap.from('.sidebar', { x: -260, duration: 0.8, ease: 'power3.out' });\n    gsap.from('.main-content header', { y: -20, opacity: 0, duration: 0.6, delay: 0.2 });\n    gsap.from('.kpi-card', { y: 20, opacity: 0, stagger: 0.1, duration: 0.6, delay: 0.4 });\n    gsap.from('.card', { y: 30, opacity: 0, duration: 0.8, delay: 0.6 });\n  });\n</script>",
