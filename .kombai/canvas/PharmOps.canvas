                </svg>\n                <span class=\"text-[10px] font-mono font-bold text-teal-500\" data-kid=\"190\">120/80</span>\n              </div>\n            </td>\n            <td data-kid=\"191\"><span class=\"badge badge-primary\" data-kid=\"192\">Kondisi Normal</span></td>\n            <td data-kid=\"193\">\n              <div class=\"flex items-center gap-1.5 text-slate-400\" data-kid=\"194\">\n                <i class=\"ti ti-checks text-xs\" data-kid=\"195\"></i>\n                <span class=\"text-[10px] font-bold uppercase tracking-tight\" data-kid=\"196\">Terpantau</span>\n              </div>\n            </td>\n            <td data-kid=\"197\"><i class=\"ti ti-chevron-right text-slate-300\" data-kid=\"198\"></i></td>\n          </tr>\n          <tr data-kid=\"199\"><td colspan=\"6\" class=\"p-0\" data-kid=\"200\"><div class=\"accordion-content\" data-kid=\"201\"></div></td></tr>\n        </tbody>\n      </table>\n      \n      <div class=\"p-4 bg-slate-50 text-center border-t border-[var(--color-border)]\" data-kid=\"202\">\n        <button class=\"text-xs font-bold text-slate-500 hover:text-[var(--color-secondary)]\" data-kid=\"203\">Tampilkan 24 lansia lainnya ↓</button>\n      </div>\n    </section>\n\n    \n    <div class=\"grid grid-cols-12 gap-8\" data-kid=\"204\">\n      <div class=\"col-span-12 card overflow-hidden\" data-kid=\"205\">\n        <div class=\"px-6 py-4 border-b border-[var(--color-border)] flex items-center justify-between\" data-kid=\"206\">\n          <h2 class=\"font-display font-bold text-sm\" data-kid=\"207\">Status Pengisian Data Pemeriksaan Lansia - Juni 2026</h2>\n          <span class=\"text-[10px] font-bold text-blue-600 bg-blue-50 px-2 py-1 rounded\" data-kid=\"208\">Update Real-time</span>\n        </div>\n        <div class=\"overflow-x-auto\" data-kid=\"209\">\n          <table class=\"w-full text-left\" data-kid=\"210\">\n            <thead class=\"bg-slate-50 text-[10px] font-bold text-slate-400 uppercase\"